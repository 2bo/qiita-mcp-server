{
  "name": "@2bo/qiita-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "qiita-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "qiita",
    "model-context-protocol"
  ],
  "author": "@2bo",
  "license": "MIT",
  "description": "MCP server for Qiita",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:2bo/qiita-mcp-server.git"
  }
}
